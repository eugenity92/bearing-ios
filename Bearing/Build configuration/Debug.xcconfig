// Hosts are stored without a scheme on purpose: xcconfig treats `//` as a comment,
// so a value containing `https://` is silently truncated. The scheme is added in
// Configuration.swift when the URL is built.

OPEN_METEO_FORECAST_HOST = api.open-meteo.com
OPEN_METEO_AIR_QUALITY_HOST = air-quality-api.open-meteo.com
